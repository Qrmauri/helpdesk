# Referencia de configuración. La aplicación lee variables del entorno;
# este archivo no se carga automáticamente.
HELPDESK_DB_HOST=localhost
HELPDESK_DB_PORT=3306
HELPDESK_DB_NAME=helpdesk
HELPDESK_DB_USER=helpdesk_app
HELPDESK_DB_PASSWORD=REEMPLAZAR_POR_UN_SECRETO_LOCAL

# Opcional: si se omite, se genera una clave temporal al arrancar la web.
HELPDESK_WEB_SECRET=GENERAR_UN_SECRETO_ALEATORIO_DE_AL_MENOS_32_CARACTERES
HELPDESK_WEB_PORT=8000
# Solo activar al servir la aplicación mediante HTTPS.
HELPDESK_WEB_HTTPS=0
